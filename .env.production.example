# The REST gateway's origin (serves /api/v2).
VITE_ORDER_API_URL=https://oms.openexchange.dev
# The user stream, the full /ws/v2 URL of oe-stream. Explicit: it is another
# process than the REST gateway and is never derived from VITE_ORDER_API_URL.
# Unset means same origin /ws/v2.
VITE_STREAM_WS_URL=wss://oms.openexchange.dev/ws/v2
# The market-data service (oe-marketdata): its /ws, and the base of the
# cross-origin GET /api/candles.
VITE_MARKET_WS_URL=wss://market.openexchange.dev

# Optional: product analytics (PostHog). Leave empty and posthog-js is dropped
# from the build entirely, which is the default for anyone deploying this UI.
# Write-only project key; safe in a public bundle. EU project.
VITE_POSTHOG_KEY=
# Optional: defaults to /ph, the first-party proxy in functions/ph/[[path]].ts.
VITE_POSTHOG_HOST=
# Optional: comma-separated hostnames allowed to report, e.g. your custom domain,
# so preview addresses (*.pages.dev) stay out of the data. Empty = every host.
VITE_POSTHOG_ALLOWED_HOSTS=
