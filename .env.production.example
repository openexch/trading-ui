VITE_ORDER_API_URL=https://oms.openexchange.dev
VITE_MARKET_WS_URL=wss://market.openexchange.dev

# Optional: product analytics (PostHog). Leave empty and posthog-js is dropped
# from the build entirely, which is the default for anyone deploying this UI.
# Write-only project key; safe in a public bundle. EU project.
VITE_POSTHOG_KEY=
# Optional: defaults to /ph, the first-party proxy in functions/ph/[[path]].ts.
VITE_POSTHOG_HOST=
